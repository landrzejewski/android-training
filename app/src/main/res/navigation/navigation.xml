<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation"
    app:startDestination="@id/ForecastFragment">

    <fragment android:id="@+id/ForecastFragment"
        android:name="pl.training.runkeeper.weather.adapters.view.ForecastFragment"
        android:label="Weather"
        tools:layout="@layout/fragment_forecast">

        <action
            android:id="@+id/show_forecast_details"
            app:destination="@id/ForecastDetailsFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out" />
    </fragment>

    <fragment android:id="@+id/ForecastDetailsFragment"
        android:name="pl.training.runkeeper.weather.adapters.view.ForecastDetailsFragment"
        android:label="Weather details"
        tools:layout="@layout/fragment_forecast_details">

    </fragment>

</navigation>